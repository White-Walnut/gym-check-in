{
  "name": "gym-check-in",
  "version": "1.9.3",
  "description": "Offline RFID gym check-in kiosk",
  "main": "src/main.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "dist": "electron-builder --win",
    "release": "npm version patch && git push && git push --tags && electron-builder --win --publish always",
    "release:minor": "npm version minor && git push && git push --tags && electron-builder --win --publish always",
    "release:major": "npm version major && git push && git push --tags && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.gym.checkin",
    "productName": "Gym Check-in",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "Gym Check-in"
    },
    "publish": {
      "provider": "github",
      "owner": "White-Walnut",
      "repo": "gym-check-in",
      "draft": false
    }
  }
}
